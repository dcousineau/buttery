{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Pure ingredient-matching package: no DOM, no network, no Node APIs
    // beyond what @types/node supplies. Runs unchanged in Node and the
    // browser, same as its consumer @buttery/web and the pipeline.
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
