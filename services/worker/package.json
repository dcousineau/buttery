{
  "name": "@buttery/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "start": "node src/worker.ts",
    "dev": "node --watch --watch-preserve-output src/worker.ts",
    "schedules:sync": "node src/schedules-sync.ts",
    "run:once": "node src/run-once.ts",
    "sync:once": "node src/run-once.ts atproto-sync",
    "test": "vitest run",
    "test:db": "vitest run --project db",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@buttery/recipe-schemas": "workspace:*",
    "@temporalio/activity": "^1.22.0",
    "@temporalio/client": "^1.22.0",
    "@temporalio/common": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.51.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.22.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
