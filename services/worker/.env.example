# services/worker/.env — copied from this file by `pnpm dev` / `mise install`
# when missing (scripts/dev/bootstrap-env.mjs). See the README.

# --- Temporal ---------------------------------------------------------------
# The local `temporal server start-dev` the dev stack runs (process-compose
# `temporal`), with its UI on http://127.0.0.1:8233. On Railway these point at
# the self-hosted cluster over private networking — see .railway/railway.ts.
TEMPORAL_ADDRESS=127.0.0.1:7233
# Buttery's own namespace, not `default` — it is Temporal's isolation boundary,
# and everything in it is declared by this repo. Created by the dev stack
# (`temporal server start-dev --namespace buttery`) and, on Railway, by the
# server's DEFAULT_NAMESPACE. A worker refuses to start if it is missing.
TEMPORAL_NAMESPACE=buttery
TEMPORAL_TASK_QUEUE=buttery

# Temporal Cloud, or any cluster reached over the public internet, wants both of
# these. The self-hosted cluster on Railway's private network wants neither.
# TEMPORAL_TLS=true
# TEMPORAL_API_KEY=

# How much one worker process runs at once. Activities are network-bound here,
# so the activity number is the one worth raising; workflow tasks are short and
# CPU-bound.
# WORKER_MAX_CONCURRENT_ACTIVITIES=8
# WORKER_MAX_CONCURRENT_WORKFLOW_TASKS=4

# --- Schedules --------------------------------------------------------------
# Cron (UTC) for the atproto sweep, reconciled onto the cluster by
# `pnpm --filter @buttery/worker schedules:sync`. Deliberately BLANK locally: a
# laptop should not quietly sweep the live atmosphere in the background. Setting
# it and re-running the reconcile turns it on; emptying it turns it off.
#
# Per-run arguments do NOT live here. A sweep that should write nothing, or stop
# after 25 repos, is a workflow argument at start time:
#   temporal workflow execute --type atprotoSync --task-queue buttery \
#     --workflow-id atproto-sync --input {"dryRun":true,"maxRepos":25}
ATPROTO_SYNC_SCHEDULE=

# --- The atproto sweep ------------------------------------------------------
# The local dev Postgres, from the repo's docker-compose.yml.
DATABASE_URL=postgresql://postgres:butterydev@localhost:55432/buttery

# Which network a sweep reads. These defaults are the real atmosphere; swap in
# the commented values to sweep the local atproto dev-env instead (its PDS list
# replaces relay enumeration — dev-env has no relay).
ATPROTO_PLC_URL=https://plc.directory        # dev-env: http://localhost:2582
RELAY_URL=https://relay1.us-east.bsky.network
SYNC_PDS_URL=                                # dev-env: http://localhost:2583

# Deployment-wide narrowing, overridden per run by the workflow's input. Either
# makes a sweep partial, which suppresses missing-repo reconciliation.
# SYNC_MAX_REPOS=25
# SYNC_ONLY_DID=did:plc:…

# How many repos are swept at once is NOT here. One repo is one activity, so the
# number in flight from a run is the workflow's `parallelism` input, and the
# number a worker will execute is WORKER_MAX_CONCURRENT_ACTIVITIES above.
