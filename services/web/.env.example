# After `railway dev up` run  `railway run --service buttery -- printenv DATABASE_URL`
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buttery

# Same deal: `railway run --service buttery -- printenv REDIS_URL`. Both ports are
# allocated fresh on every `railway dev up`, so re-read them after a restart —
# `pnpm dev` runs through `railway run` and gets the live values regardless.
#
# `railway dev` only publishes a host port for a service that has a public TCP
# proxy on Railway; without one it writes the compose entry with no `ports:` key,
# silently, while still handing the app a localhost URL. That shows up as an
# endless ECONNREFUSED in .dev-logs/web.log. Add the proxy under the service's
# Settings -> Networking (application port 6379) and restart the stack.
REDIS_URL=redis://default:<password>@localhost:6379

# better-auth session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app. In dev this must stay 127.0.0.1 (not localhost):
# the atproto loopback OAuth client redirects back to 127.0.0.1, and the
# session cookie is set on that host. Browse the dev server at this URL.
BETTER_AUTH_URL=http://127.0.0.1:3000

# Same origin, exposed to the Vite client bundle for SEO/OG absolute URLs
# (og:image / og:url / canonical). Keep in sync with BETTER_AUTH_URL.
VITE_APP_URL=http://127.0.0.1:3000

# PostHog client configuration (inlined into the client bundle at build time)
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<ph_project_token>
VITE_PUBLIC_POSTHOG_HOST=<ph_client_api_host>

# PostHog server-side config, read at runtime by posthog-node to evaluate the
# `invited` access flag and identify people by handle (src/lib/posthog-server.ts).
# Server-to-server, so HOST is PostHog's ingestion origin, not the client proxy.
# The invite gate is bypassed whenever NODE_ENV is development/test, regardless of
# this token — local sign-ins use throwaway dev-env DIDs that can never be on the
# invite list. Unsetting the token does NOT bypass anything on its own.
POSTHOG_PROJECT_TOKEN=<ph_project_token>
POSTHOG_HOST=https://us.i.posthog.com

# --- Local ATProto dev publishing (DEV ONLY; leave UNSET in prod) ---
# Point OAuth handle + DID resolution at a local @atproto/dev-env network so
# recipe publishes land in a local PDS and never reach the real atmosphere.
# Start the network with `pnpm atproto:dev-env` and paste the block it prints:
#   ATPROTO_HANDLE_RESOLVER=http://localhost:2583   # local PDS (serves resolveHandle + OAuth)
#   ATPROTO_PLC_URL=http://localhost:2582           # local PLC (did:plc resolution)
#   ATPROTO_PUBLISH_ENABLED=true                    # flips the fail-closed publish gate
# Then sign in with the seed handle (default chef.test) and publish. See
# services/atproto-dev-env/README.md.
