# After `railway dev up` run  `railway run --service buttery -- printenv DATABASE_URL`
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buttery

# better-auth session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app. In dev this must stay 127.0.0.1 (not localhost):
# the atproto loopback OAuth client redirects back to 127.0.0.1, and the
# session cookie is set on that host. Browse the dev server at this URL.
BETTER_AUTH_URL=http://127.0.0.1:3000

# Same origin, exposed to the Vite client bundle for SEO/OG absolute URLs
# (og:image / og:url / canonical). Keep in sync with BETTER_AUTH_URL.
VITE_APP_URL=http://127.0.0.1:3000

# PostHog client configuration (inlined into the client bundle at build time)
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<ph_project_token>
VITE_PUBLIC_POSTHOG_HOST=<ph_client_api_host>

# PostHog server-side config, read at runtime by posthog-node to evaluate the
# `invited` access flag and identify people by handle (src/lib/posthog-server.ts).
# Server-to-server, so HOST is PostHog's ingestion origin, not the client proxy.
# Leave the token UNSET in local dev to bypass the invite gate (the app stays
# ungated locally, same as before).
POSTHOG_PROJECT_TOKEN=<ph_project_token>
POSTHOG_HOST=https://us.i.posthog.com
