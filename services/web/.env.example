# services/web/.env — local dev configuration.
#
# `mise install` and `pnpm dev` copy this file to `.env` (same directory) when
# that file is missing, generating the one blank value below that has to be set
# (BETTER_AUTH_SECRET) — see scripts/dev/bootstrap-env.mjs. An existing `.env`
# is never touched. By hand:
#     cp services/web/.env.example services/web/.env
#
# `.env` is gitignored. `pnpm dev` reads it two ways, no Railway CLI involved:
#   * the web server — vite.config.ts loads it into process.env for dev
#   * migrations   — kysely.config.ts loads it for the `db:migrate:*` CLI
# Every value here used to be injected by `railway run`; it now lives in this
# file. The DATABASE_URL / REDIS_URL below already match the fixed ports in the
# repo's docker-compose.yml, so a fresh clone works after just `cp` + a secret.

# --- Datastores (docker-compose.yml) --------------------------------------
# Fixed host ports and throwaway local-only credentials, straight from
# docker-compose.yml. High ports (55432/56379) so a Postgres/Redis you already
# run on the defaults (5432/6379) does not collide. Change these only if you
# also change the compose file.
DATABASE_URL=postgresql://postgres:butterydev@localhost:55432/buttery
REDIS_URL=redis://default:butterydev@localhost:56379

# --- Auth -----------------------------------------------------------------
# better-auth session signing secret. Generate a throwaway one for local dev:
#     openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app. In dev this MUST stay 127.0.0.1 (not localhost):
# the atproto loopback OAuth client redirects back to 127.0.0.1, the session
# cookie is set on that host, and atproto forbids `.localhost` client_ids.
# Browse the dev server at this URL.
BETTER_AUTH_URL=http://127.0.0.1:3000

# Same origin, exposed to the Vite client bundle for SEO/OG absolute URLs
# (og:image / og:url / canonical). Keep in sync with BETTER_AUTH_URL.
VITE_APP_URL=http://127.0.0.1:3000

# --- Blob storage (BLOB_S3_*) — LOCAL RustFS container ----------------------
# S3-compatible object storage for every image Buttery holds on a user's behalf.
# A recipe that comes through us — created here, imported from a URL, imported
# from a folder — has its photo HERE, always; the original image URL is never
# stored and never rendered. On publish the object is read back and piped to the
# author's PDS as an atproto blob, after which the image is served by an atproto
# CDN instead.
#
# The bytes never pass through the web server. It signs a presigned POST and the
# BROWSER sends the file straight at this endpoint, then reads it back through a
# presigned GET. So this has to be reachable FROM THE BROWSER, not just from the
# server — 127.0.0.1, never a container hostname.
#
# This used to point at the shared REMOTE Railway `buttery-uploads` bucket — the
# one piece of local dev that was not a local container, and the one place a
# local mistake wrote objects other developers could see. It is now the `rustfs`
# container in the repo's docker-compose.yml, started by `pnpm dev` with the
# bucket AND its CORS rule created on boot (services/web/scripts/create-bucket.mjs
# — that rule is what lets the browser POST at all, and it allows the origin in
# VITE_APP_URL above). Throwaway local-only credentials, same as postgres/redis.
#
# BLOB_S3_FORCE_PATH_STYLE is a local-dev knob: the dev container routes
# path-style only (http://host:9000/<bucket>/<key>), while Railway's buckets are
# virtual-hosted and leave this unset.
BLOB_S3_ENDPOINT=http://127.0.0.1:59000
BLOB_S3_REGION=us-east-1
BLOB_S3_BUCKET=buttery-uploads
BLOB_S3_ACCESS_KEY_ID=butterydev
BLOB_S3_SECRET_ACCESS_KEY=butterydevsecret
BLOB_S3_FORCE_PATH_STYLE=true

# --- PostHog (PRODUCTION ONLY — leave the two ENABLED vars UNSET locally) ---
#
# PostHog is a total no-op unless BOTH gates below are the exact string "true":
# posthog-js is never initialized, posthog-node never constructed, so no event,
# no person, and no `$feature_flag_called` write can leave a dev/test machine.
# They are set only on the deployed service (.railway/railway.ts). Nothing in the
# app gates on a flag it cannot evaluate, so you do not need PostHog locally.
#
#   VITE_PUBLIC_POSTHOG_ENABLED=true   # client, inlined at build time
#   POSTHOG_ENABLED=true               # server, read at runtime
#
# The tokens themselves are harmless without their ENABLED gate. Leave them at
# the placeholders (or unset) locally:
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<ph_project_token>
VITE_PUBLIC_POSTHOG_HOST=<ph_client_api_host>
POSTHOG_PROJECT_TOKEN=<ph_project_token>
POSTHOG_HOST=https://us.i.posthog.com

# --- Local ATProto dev publishing (DEV ONLY; leave UNSET in prod) ---------
# Point OAuth handle + DID resolution at the local @atproto/dev-env network
# (`pnpm dev` starts it) so recipe publishes land in a local PDS and never reach
# the real atmosphere. Then sign in with the seed handle (default chef.test) and
# publish. See services/atproto-dev-env/README.md.
ATPROTO_HANDLE_RESOLVER=http://localhost:2583
ATPROTO_PLC_URL=http://localhost:2582
ATPROTO_PUBLISH_ENABLED=true
