{
  "name": "@buttery/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm --filter @buttery/lexicons build && vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "pnpm --filter @buttery/lexicons build && vite build",
    "start": "srvx --prod --entry dist/server/server.js --static ../client",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "railway run --service buttery -- vitest run --project db",
    "db:migrate:up": "kysely migrate latest",
    "db:migrate:down": "kysely migrate down",
    "db:migrate:new": "kysely migrate make",
    "db:migrate:list": "kysely migrate list",
    "db:seed:make": "kysely seed make",
    "db:seed:run": "kysely seed run",
    "db:seed:list": "kysely seed list",
    "db:reset:users": "node scripts/reset-user-data.ts",
    "dev:bucket": "node scripts/create-bucket.mjs",
    "db:codegen": "kysely-codegen --out-file src/db/types.ts --exclude-pattern \"*.kysely_migration*\"",
    "typecheck": "pnpm --filter @buttery/lexicons build && tsc && tsc -p tsconfig.sw.json"
  },
  "dependencies": {
    "@atproto/lex": "^0.3.11",
    "@atproto/oauth-client": "^0.8.7",
    "@atproto/oauth-client-node": "^0.5.7",
    "@atproto/oauth-types": "^0.7.6",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-presigned-post": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@base-ui/react": "^1.8.0",
    "@buttery/food": "workspace:*",
    "@buttery/lexicons": "workspace:*",
    "@buttery/pipeline-contract": "workspace:*",
    "@buttery/recipe-extract": "workspace:*",
    "@buttery/recipe-schemas": "workspace:*",
    "@mantine/hooks": "^9.6.1",
    "@posthog/react": "^1.11.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-utils": "^0.7.0",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.54",
    "@tanstack/router-plugin": "^1.168.38",
    "better-auth": "^1.7.4",
    "bullmq": "^6.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.52.0",
    "idb-keyval": "^6.3.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.5",
    "kysely-ctl": "^0.21.0",
    "lucide-react": "^1.46.0",
    "parse-ingredient": "^2.2.0",
    "pg": "^8.23.0",
    "posthog-js": "^1.433.2",
    "posthog-node": "^5.52.2",
    "railway": "^3.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satori": "^0.29.1",
    "srvx": "^0.12.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/router-cli": "^1.167.36",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "kysely-codegen": "^0.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
