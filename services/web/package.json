{
  "name": "@buttery/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm --filter @buttery/lexicons build && vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "pnpm --filter @buttery/lexicons build && vite build",
    "start": "srvx --prod --entry dist/server/server.js --static ../client",
    "preview": "vite preview",
    "test": "vitest run",
    "db:migrate:up": "kysely migrate latest",
    "db:migrate:down": "kysely migrate down",
    "db:migrate:new": "kysely migrate make",
    "db:migrate:list": "kysely migrate list",
    "db:codegen": "kysely-codegen --out-file src/db/types.ts --exclude-pattern \"*.kysely_migration*\"",
    "typecheck": "pnpm --filter @buttery/lexicons build && tsc"
  },
  "dependencies": {
    "@atproto/lex": "^0.3.2",
    "@atproto/oauth-client": "^0.8.1",
    "@atproto/oauth-client-node": "^0.5.1",
    "@atproto/oauth-types": "^0.7.5",
    "@base-ui/react": "^1.6.0",
    "@buttery/lexicons": "workspace:*",
    "@mantine/hooks": "^9.5.0",
    "@posthog/react": "^1.10.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.168.23",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "es-toolkit": "^1.50.0",
    "kysely": "^0.29.4",
    "kysely-ctl": "^0.21.0",
    "lucide-react": "^1.28.0",
    "pg": "^8.22.0",
    "posthog-js": "^1.409.5",
    "railway": "^3.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "srvx": "^0.12.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "kysely-codegen": "^0.20.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
