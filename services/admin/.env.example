# services/admin/.env — local dev configuration for the backoffice admin.
#
# Created from this file by `scripts/dev/bootstrap-env.mjs` (run by `pnpm dev`
# and the mise postinstall hook), which fills the blank ADMIN_BETTER_AUTH_SECRET
# below. By hand:
#     cp services/admin/.env.example services/admin/.env
#
# `.env` is gitignored. It is read by vite.config.ts (the dev server) and by
# scripts/create-admin.ts.

# --- Database -------------------------------------------------------------
# THE SAME DATABASE AS THE APP. That is the point of the tool: it reads the
# app's real tables. The isolation is at the schema level — everything the admin
# owns lives in the `admin` Postgres schema, and the connection sets
# `search_path = admin, public` so an unqualified name resolves there first
# (see src/lib/db.ts). Keep this identical to services/web/.env.
DATABASE_URL=postgresql://postgres:butterydev@localhost:55432/buttery

# --- Auth -----------------------------------------------------------------
# A SEPARATE better-auth signing secret from the app's. It must not be the
# BETTER_AUTH_SECRET in services/web/.env: sharing it would let a token minted
# for one app verify against the other, which is exactly the boundary this
# service exists to hold. Generate a throwaway one for local dev:
#     openssl rand -base64 32
ADMIN_BETTER_AUTH_SECRET=

# Public origin of the admin. Cookies ignore ports — 127.0.0.1:3000 and
# 127.0.0.1:3100 share one cookie jar — so the admin's cookies are namespaced by
# prefix instead (`buttery-admin.*`, set in src/lib/auth.ts). Changing this port
# means changing it in vite.config.ts and process-compose.yaml too.
ADMIN_APP_URL=http://127.0.0.1:3100
