# Postgres to write the sync index into. Point at the local dev DB when
# bootstrapping (see README). Easiest is to let Railway inject it:
#   railway run --service atproto-cron-sync -- printenv DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buttery

# Enumeration relay (listReposByCollection). Optional; this is the default.
RELAY_URL=https://relay1.us-east.bsky.network

# Per-DID concurrency pool size. Optional; defaults to 8.
# SYNC_CONCURRENCY=8

# Bootstrap helpers (optional):
# SYNC_MAX_REPOS=25       # stop after N DIDs — fast partial bootstrap
# SYNC_ONLY_DID=did:plc:… # sync a single DID — debugging one repo
