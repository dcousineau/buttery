{
  "name": "@buttery/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "start": "node src/server.ts",
    "start:worker": "node src/worker.ts",
    "dev": "node --watch src/server.ts",
    "dev:worker": "node --watch src/worker.ts",
    "run:once": "node src/cli/run-once.ts",
    "sync:once": "node src/cli/run-once.ts atproto-sync",
    "test": "vitest run",
    "test:db": "vitest run --project db",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@ai-sdk/provider-utils": "^5.0.30",
    "@bull-board/api": "^8.6.1",
    "@bull-board/fastify": "^8.6.1",
    "@buttery/food": "workspace:*",
    "@buttery/pipeline-contract": "workspace:*",
    "@buttery/recipe-schemas": "workspace:*",
    "@fastify/autoload": "^6.5.0",
    "@fastify/basic-auth": "^6.3.0",
    "@posthog/ai": "^8.8.1",
    "ai": "^7.0.79",
    "bullmq": "^6.1.2",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.51.0",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "posthog-node": "^5.49.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
