{
  "name": "@buttery/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "start": "node src/server.ts",
    "start:worker": "node src/worker.ts",
    "dev": "node --watch src/server.ts",
    "dev:worker": "node --watch src/worker.ts",
    "trigger": "node src/cli/trigger.ts",
    "backfill": "node src/cli/backfill.ts",
    "prompt": "node src/cli/enrichment-prompt.ts",
    "sync:trigger": "node src/cli/trigger.ts atproto-sync",
    "test": "vitest run",
    "test:db": "vitest run --project db",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/otel": "^1.0.99",
    "@ai-sdk/provider-utils": "^5.0.40",
    "@bull-board/api": "^8.6.1",
    "@bull-board/fastify": "^8.6.1",
    "@buttery/food": "workspace:*",
    "@buttery/pipeline-contract": "workspace:*",
    "@buttery/recipe-schemas": "workspace:*",
    "@fastify/autoload": "^6.5.0",
    "@fastify/basic-auth": "^6.3.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@posthog/ai": "^8.11.1",
    "ai": "^7.0.99",
    "bullmq": "^6.3.6",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.52.0",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "posthog-node": "^5.52.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
