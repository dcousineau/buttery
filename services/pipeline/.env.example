# services/pipeline/.env — copied from this file by `pnpm dev` / `mise install`
# when missing (scripts/dev/bootstrap-env.mjs). See the README.
#
# One file for the whole service: the queue system below, and the workflows it
# runs further down. `services/atproto-cron-sync/.env` used to hold the second
# half; that package is gone and its variables moved here verbatim.

# --- the queue system ------------------------------------------------------

# The local dev Redis, from the repo's docker-compose.yml. BullMQ stores every
# queue, job and scheduler here; wiping it (`docker compose down -v`) resets the
# workflows to empty.
REDIS_URL=redis://:butterydev@localhost:56379

# Where the Fastify server (and the Bull Board UI at /ui) listens.
PORT=3002

# Basic-auth credentials for the board and the job API. Leave the password blank
# locally — the dev stack is loopback-only and an unset password means no login
# prompt. It is REQUIRED in production: the board shows every job payload and
# lets a visitor retry, promote and delete jobs.
PIPELINE_AUTH_USER=buttery
PIPELINE_AUTH_PASSWORD=

# Jobs one worker process interleaves. Replicas are the other dial — see the
# README's autoscaling section for which one to reach for.
# PIPELINE_WORKER_CONCURRENCY=4

# Autoscaling is Railway-only and opt-in: without RAILWAY_API_TOKEN the loop
# never starts, which is why nothing here configures it. See .railway/railway.ts.

# --- workflow: atproto-sync ------------------------------------------------

# Cron pattern (UTC) for the atproto → Postgres sweep. Deliberately BLANK
# locally: a laptop should not quietly sweep the live atmosphere in the
# background. Railway sets it to hourly (see .railway/railway.ts).
#
# Uncomment for a sweep every five minutes and watch it in the board, or trigger
# one on demand at any time without a schedule:
#   curl -X POST http://127.0.0.1:3002/jobs/atproto-sync
# ATPROTO_SYNC_SCHEDULE=*/5 * * * *

# The local dev Postgres, from the repo's docker-compose.yml. Where the sweep
# writes; the schema itself belongs to @buttery/web's migrations.
DATABASE_URL=postgresql://postgres:butterydev@localhost:55432/buttery

# Which network a sweep reads — the same answer whether it runs on the schedule,
# from the board, or from `pnpm --filter @buttery/pipeline sync:once`. These
# defaults are the real atmosphere; swap in the commented values to sweep the
# local atproto dev-env instead (its PDS list replaces relay enumeration —
# dev-env has no relay).
ATPROTO_PLC_URL=https://plc.directory        # dev-env: http://localhost:2582
RELAY_URL=https://relay1.us-east.bsky.network
SYNC_PDS_URL=                                # dev-env: http://localhost:2583

# Optional narrowing; either makes the sweep partial (no delete reconciliation).
# SYNC_MAX_REPOS=25
# SYNC_ONLY_DID=did:plc:…
# SYNC_CONCURRENCY=8
