// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
//
// `@docusaurus/tsconfig` is inlined rather than extended: it sets `baseUrl`, which
// TypeScript 7 removed (TS5102), and an inherited option cannot be unset from a
// child config. Everything below is that file verbatim minus `baseUrl` — `paths`
// resolves relative to this tsconfig without it — plus our `strict`.
{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
