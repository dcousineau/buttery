# Per-process plain-text logs written by process-compose (see process-compose.yaml)
.dev-logs
# Persistent local-dev state (atproto PDS sqlite, blobstore, PLC snapshot).
# Deleting it resets the dev-env and mints a new did:plc for the seed account.
.dev-data
.mcp.json
# Timestamped copies of the rendered config `mise run setup:reset` replaces.
*.bak.[0-9]*
.pnpm-store
# Snapshots / screenshots / traces the Playwright MCP writes into the project.
.playwright-mcp

# @atproto/lex generated TypeScript — regenerated from lexicons/ via the
# @buttery/lexicons `build` script. The source of truth (lexicons/*.json +
# lexicons.json manifest) IS committed.
/packages/lexicons/src/generated

# Coherence per-run scratch. The durable records (.coherence/status.json,
# decisions/, work/, consequences/, hooks/) stay committed.
.coherence/verify-jobs.json
.coherence/test-report.json
# Per-session hook telemetry: proves the control fired in THIS session, and old
# rows can't redeem wiring removed today. One file per session forever is churn.
.coherence/activity/
