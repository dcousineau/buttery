# Server-only (no VITE_ prefix — never exposed to the client).
#
# Local dev flow: run `railway dev` in one terminal (postgres in Docker),
# `pnpm dev` in another with this file filled in. To build DATABASE_URL:
#   1. Start (or dry-run) railway dev once, then read the generated compose:
#        cat ~/.railway/develop/<project-id>/docker-compose.yml
#      (project-id: `railway status --json` → .id)
#   2. Take the postgres service's host port mapping (`- <PORT>:5432`) and
#      POSTGRES_PASSWORD, then:
#        DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:<PORT>/railway
#      (railway dev mirrors the prod password locally; db name is `railway`.)
#   3. First start only: the local volume is empty — apply the schema with
#        pnpm db:migrate:up
#      (re-run after `railway dev clean`).
# Running the app inside `railway dev` also works: the injected *.localhost
# BETTER_AUTH_URL is collapsed to http://127.0.0.1:3000 by oauth-node.ts
# (atproto forbids .localhost client_ids). Always browse at 127.0.0.1:3000.
#
# Fallback for a hand-run local postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buttery

# better-auth session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app. In dev this must stay 127.0.0.1 (not localhost):
# the atproto loopback OAuth client redirects back to 127.0.0.1, and the
# session cookie is set on that host. Browse the dev server at this URL.
BETTER_AUTH_URL=http://127.0.0.1:3000
