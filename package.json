{
  "name": "buttery",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev/up.sh",
    "dev:attach": "process-compose attach",
    "dev:down": "process-compose down",
    "dev:web": "pnpm --filter @buttery/web dev",
    "dev:docs": "pnpm --filter @buttery/docs start --port 3001 --host 127.0.0.1 --no-open",
    "atproto:dev-env": "pnpm --filter @buttery/atproto-dev-env start",
    "build": "pnpm -r build",
    "start": "pnpm --filter @buttery/web start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:db": "pnpm --filter @buttery/web test:db",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "railway": "^3.8.1",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yaml,yml,css}": "oxfmt",
    "*.{js,jsx,ts,tsx}": "oxlint --fix"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.20.0"
}
