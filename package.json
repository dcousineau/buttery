{
  "name": "buttery",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "bash scripts/dev/up.sh",
    "dev:attach": "process-compose attach",
    "dev:down": "process-compose down; railway dev down",
    "dev:web": "pnpm --filter @buttery/web dev",
    "atproto:dev-env": "pnpm --filter @buttery/atproto-dev-env start",
    "build": "pnpm -r build",
    "start": "pnpm --filter @buttery/web start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:db": "pnpm --filter @buttery/web test:db",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yaml,yml,css}": "prettier --write --ignore-unknown",
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "railway": "^3.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0"
  }
}
