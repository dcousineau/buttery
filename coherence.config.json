{
  "typecheck": ["pnpm", "-r", "typecheck"],
  "test": ["pnpm", "--filter", "@buttery/web", "exec", "vitest", "run", "-t"],
  "testBatch": ["pnpm", "--filter", "@buttery/web", "exec", "vitest", "run", "--reporter=json"],
  "testMatch": "[1-9][0-9]* passed",
  "ignore": ["node_modules", ".git", "dist", ".turbo", ".wrangler", "routeTree.gen.ts", "generated"]
}
